# App runtime mode:
#   static = chunks under public/data/ (no live artworks table).
#   supabase = load artworks from Supabase (required to show approved user submissions on the globe).
# See docs/auth-social-setup.md for OAuth, moderation, and UGC.
VITE_DATA_SOURCE=static

# Supabase runtime (browser, read-only)
VITE_SUPABASE_URL=https://bxowosktluacjwvutvqi.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_HGcmFx2zi4ElgOrVNYgh-w_x86jKNHf
VITE_SUPABASE_TABLE=artworks
VITE_SUPABASE_DEFAULT_LIMIT=3000

# Pipeline (Node scripts)
SUPABASE_URL=https://bxowosktluacjwvutvqi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_h5l9h33ZV0QtVxTbfiv3Cw_bFZCbMhA
SUPABASE_STORAGE_BUCKET=art-images
# Kaggle6 images: Cloudflare R2 (recommended) or Supabase Storage — auto if all R2_* are set, else Supabase
# KAGGLE6_IMAGE_STORAGE=r2
# KAGGLE6_IMAGE_STORAGE=supabase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for browser-loaded images (R2.dev or custom domain), no trailing slash
R2_PUBLIC_BASE_URL=
# R2_KEY_PREFIX=art-globe
# Bulk upload all public/artworks/* rasters to R2: npm run upload:artworks:r2
# R2_BULK_UPLOAD_DRY_RUN=false
# R2_BULK_UPLOAD_CONCURRENCY=8
# Then: npm run data:rewrite-cdn-urls && npm run data:runtime && npm run build:production
SUPABASE_ARTWORKS_TABLE=artworks
SUPABASE_UPSERT_BATCH_SIZE=500
SUPABASE_DRY_RUN=false

# Local Kaggle roots (optional overrides)
KAGGLE6_ROOT=
KAGGLE2_ROOT=
# Kaggle2 static merge: optional caps and placeholder image (default /artworks/external/external-unavailable.svg)
# KAGGLE2_MAX_MERGE_TOTAL=3000
# KAGGLE2_MAX_PER_ARTIST_MERGE=20
# KAGGLE2_PLACEHOLDER_IMAGE_URL=/artworks/external/external-unavailable.svg
# KAGGLE2_MERGE_INPUT=tmp/kaggle2-validated.json

# kaggle6:local-images — resize/compress to public/ (default webp, 512px max edge; much smaller than raw copies)
# KAGGLE6_LOCAL_IMAGE_MAX_EDGE=512
# KAGGLE6_LOCAL_IMAGE_QUALITY=80
# KAGGLE6_LOCAL_IMAGE_FORMAT=webp
# Merge prefers tmp/kaggle6-local-for-merge.json over tmp/kaggle6-uploaded.json when both exist. Cloud-only: KAGGLE6_MERGE_INPUT=tmp/kaggle6-uploaded.json

# Archive-6 import: smoke test ~50 artworks for end-to-end pipeline checks
# KAGGLE6_SMOKE=1
# Scaling (more art): full runs omit KAGGLE6_SMOKE; raise cap if needed
# KAGGLE6_MAX_CANDIDATES=20000
# KAGGLE6_MAX_PER_ARTIST_IMPORT=20
# KAGGLE6_MIN_LOCATION_CONFIDENCE=0.68
# KAGGLE6_MIN_OVERALL_CONFIDENCE=0.62
# KAGGLE6_MAX_PER_CITY=140
# KAGGLE6_IMAGE_MAX_BYTES=350000
# KAGGLE6_MAX_MERGE_TOTAL=15000
# KAGGLE6_MAX_PER_ARTIST_MERGE=20
# ART_DATA_CHUNK_SIZE=300

# Kaggle2 scaling
# KAGGLE2_MAX_CANDIDATES=10000
# KAGGLE2_MAX_PER_ARTIST_IMPORT=20
# KAGGLE2_MIN_LOCATION_CONFIDENCE=0.65
# KAGGLE2_MIN_OVERALL_CONFIDENCE=0.6
# KAGGLE2_MAX_PER_CITY=120

# Wikimedia API (enrich scripts): retries on 429/502/503, optional pacing
# WIKIMEDIA_FETCH_MAX_RETRIES=6
# WIKIMEDIA_FETCH_INITIAL_BACKOFF_MS=1000
# WIKIMEDIA_FETCH_MAX_BACKOFF_MS=32000
# WIKIMEDIA_FETCH_MIN_INTERVAL_MS=0
# KAGGLE6_REQUEST_MIN_INTERVAL_MS=150
# KAGGLE2_REQUEST_MIN_INTERVAL_MS=150
# Slow or flaky network: raise per-request timeout (ms) for enrich — e.g. KAGGLE6_REQUEST_TIMEOUT_MS=20000
