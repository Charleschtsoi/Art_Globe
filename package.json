{
  "name": "art-globe",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "vite build && node scripts/strip-artwork-binaries-from-dist.mjs",
    "upload:artworks:r2": "node scripts/upload-all-images-to-r2.mjs",
    "data:rewrite-cdn-urls": "node scripts/rewrite-image-urls-for-cdn.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "fetch:artworks": "node fetchArtworks.js",
    "localize:asia": "node scripts/localize-asia-thumbnails.mjs",
    "localize:external": "node scripts/localize-external-thumbnails.mjs",
    "thumb:proxy": "node scripts/thumb-proxy.mjs",
    "fetch:museum": "node fetchMuseumData.js",
    "fetch:oceania-seasia": "node fetchOceaniaSeAsia.js",
    "fetch:africa": "node fetchAfrica.js",
    "fetch:met": "node fetchMetMuseumData.js",
    "archive3:import": "node scripts/import-archive3.mjs",
    "archive3:enrich": "node scripts/enrich-archive3-metadata.mjs",
    "archive3:validate": "node scripts/validate-archive3-city-consistency.mjs",
    "archive3:upload": "node scripts/upload-archive3-images.mjs",
    "archive3:merge": "node scripts/merge-archive3-into-external.mjs",
    "wikiart:import": "node scripts/import-wikiart.mjs",
    "wikiart:enrich": "node scripts/enrich-wikiart-metadata.mjs",
    "wikiart:validate": "node scripts/validate-wikiart.mjs",
    "wikiart:upload": "node scripts/upload-wikiart-images.mjs",
    "wikiart:merge": "node scripts/merge-wikiart-into-external.mjs",
    "kaggle6:import": "node scripts/import-kaggle6.mjs",
    "kaggle6:import:smoke": "KAGGLE6_SMOKE=1 node scripts/import-kaggle6.mjs",
    "kaggle6:enrich": "node scripts/enrich-kaggle6-metadata.mjs",
    "kaggle6:validate": "node scripts/validate-kaggle6.mjs",
    "kaggle6:upload": "node scripts/upload-kaggle6-images.mjs",
    "kaggle6:local-images": "node scripts/kaggle6-copy-images-local.mjs",
    "kaggle6:merge": "node scripts/merge-kaggle6-into-external.mjs",
    "kaggle6:upsert": "node scripts/upsert-to-supabase.mjs tmp/kaggle6-uploaded.json",
    "kaggle2:import": "node scripts/import-kaggle2.mjs",
    "kaggle2:enrich": "node scripts/enrich-kaggle2-metadata.mjs",
    "kaggle2:validate": "node scripts/validate-kaggle2.mjs",
    "kaggle2:merge": "node scripts/merge-kaggle2-into-external.mjs",
    "kaggle2:upsert": "node scripts/upsert-to-supabase.mjs tmp/kaggle2-validated.json accepted",
    "i18n:generate-zh-overlays": "node scripts/generate-content-zh-overlays.mjs",
    "data:runtime": "node scripts/build-runtime-data.mjs",
    "test:integration": "playwright test",
    "check:data": "node scripts/check-art-data.mjs",
    "benchmark:data": "node scripts/benchmark-runtime-data.mjs",
    "pipeline:counts": "node scripts/report-pipeline-counts.mjs"
